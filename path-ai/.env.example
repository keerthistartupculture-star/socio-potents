# ── Hosting ───────────────────────────────────────────────────────────────
# Path AI is served under sociopotents.in/path-ai. Read for both `next build` and
# `next start` — keep this line, or every Path AI page returns 404.
NEXT_PUBLIC_BASE_PATH="/path-ai"

# ── Database ──────────────────────────────────────────────────────────────
# PostgreSQL connection string. Prisma uses this for all reads/writes.
DATABASE_URL="postgresql://user:password@localhost:5432/careercompass?schema=public"

# ── AI (Google Gemini) ───────────────────────────────────────────────────
# Server-side only. NEVER prefix with NEXT_PUBLIC_ — it must never reach the browser bundle.
# Used exclusively inside src/services/geminiService.ts.
GEMINI_API_KEY="your-gemini-api-key"
# gemini-3.6-flash's free tier is capped at 20 requests/day PER MODEL — a single test
# conversation burns most of that. Quota is tracked per model name, so gemini-3.1-flash-lite
# (same account, same key) has its own separate, much less exhausted daily allowance and is
# the default here for that reason. Switch back to gemini-3.6-flash (or any other model your
# key has access to) once billing is enabled on the underlying Google Cloud project.
GEMINI_MODEL="gemini-3.1-flash-lite"
# Backup model, used automatically when the main one is overloaded (503) or out of free quota (429).
# Each model has its own free-tier quota, so this also roughly doubles daily capacity. "" turns it off.
GEMINI_FALLBACK_MODEL="gemini-flash-lite-latest"

# ── Analytics (Mixpanel) ─────────────────────────────────────────────────
# Server-side token used by src/services/analyticsService.ts to proxy events.
# Kept server-side (not NEXT_PUBLIC_) so we control exactly which properties leave the app.
MIXPANEL_TOKEN="your-mixpanel-project-token"

# ── Auth (NextAuth / Auth.js) ────────────────────────────────────────────
# Random 32+ byte secret used to sign session/JWT tokens. Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# Path AI is served at sociopotents.in/path-ai, so this must include /path-ai/api/auth.
NEXTAUTH_URL="https://sociopotents.in/path-ai/api/auth"

# Optional Google OAuth login (leave blank to disable "Sign in with Google").
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── App ───────────────────────────────────────────────────────────────────
# Used in reminder emails; must include /path-ai.
APP_URL="https://sociopotents.in/path-ai"
APP_NAME="PATH AI"

# Separate, longer-lived secret for signing admin JWT sessions (kept apart from
# NEXTAUTH_SECRET so admin sessions can be revoked/rotated independently of user sessions).
ADMIN_JWT_SECRET="replace-with-a-different-long-random-string"

# Comma-separated seed admin email(s) allowed to log in as SUPER_ADMIN after `prisma:seed`.
# The seed script hashes a randomly generated password and prints it once to the console —
# it is never committed or hardcoded.
SEED_ADMIN_EMAIL="admin@careercompass.local"
# Optional: set the admin's password yourself (8+ characters) instead of a printed random one.
# Applied on every seed run, so changing it and restarting resets a lost admin password.
SEED_ADMIN_PASSWORD=""

# ── Email (Resend) ───────────────────────────────────────────────────────
# Optional. Used by src/services/notificationService.ts to send recovery/reminder emails
# (see /admin/recovery — nudges for users who registered but never started, paused
# mid-assessment, or never opened a finished report). Leave blank to keep the recovery
# feature fully usable in "log only" mode — nothing is emailed until this is set.
RESEND_API_KEY=""
NOTIFICATIONS_FROM_EMAIL="onboarding@resend.dev"

# ── Automatic recovery sweeps ────────────────────────────────────────────
# POST (or GET) /api/cron/recovery runs the recovery scan-and-send automatically — point an
# external scheduler at it (Render Cron Job, Vercel Cron, cron-job.org, GitHub Actions
# schedule, ...) with this secret as a Bearer token or a ?secret= query param, e.g. hourly:
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" https://your-app.com/api/cron/recovery
# Required for the endpoint to run at all — with this unset it refuses every request (503),
# so automatic sweeps are opt-in, never accidentally on. Generate with: openssl rand -hex 24
CRON_SECRET=""
# How long to wait before reminding the same person about the same stalled state again.
RECOVERY_COOLDOWN_HOURS="48"

# ── Feature flags ────────────────────────────────────────────────────────
# When true, assessment/report endpoints use canned demo data instead of calling Gemini,
# so the product can be demoed without burning API credits. Toggle live from /admin/settings.
DEMO_MODE_DEFAULT="false"

# Rate limiting (requests per window) for public-facing API routes.
RATE_LIMIT_MAX="60"
RATE_LIMIT_WINDOW_MS="60000"

# Optional TRAINER account (marks skill checks) created by the seed when both are set.
SEED_TRAINER_EMAIL=""
SEED_TRAINER_PASSWORD=""
